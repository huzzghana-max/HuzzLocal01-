# Huzz Backend - Environment Variables
# Copy this file to .env in the server directory and fill in your actual values

## Database Configuration
# Use Supabase Postgres for production
SUPABASE_DB_URL=postgresql://user:password@host:port/database

# OR use local MySQL (development)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=huzz_auth
MYSQL_PORT=3306

## Authentication
# JWT secret for signing tokens - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-in-production

## Payment Processing (Paystack)
# Get keys from Paystack dashboard: https://dashboard.paystack.com/
# Test keys for development, Live keys for production
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_CURRENCY=GHS

## Email Configuration
# Option 1: Resend (recommended for production)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@huzz.app

# Option 2: Mailtrap SMTP (or any SMTP service)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_SECURE=false
MAIL_USER=your_mailtrap_user
MAIL_PASS=your_mailtrap_password
MAIL_FROM=noreply@huzz.app

## Admin Configuration
# These are used to bootstrap admin user on first run
ADMIN_BOOTSTRAP_EMAIL=admin@huzz.app
ADMIN_BOOTSTRAP_PASSWORD=change-in-production-and-login-to-reset
ADMIN_BOOTSTRAP_NAME=Huzz Admin

## Environment
# Set to 'production' on hosted server
NODE_ENV=development

## Server Port (usually overridden by host)
PORT=5000

## Optional: CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

## Supabase Auth (optional - for future authentication migration)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxx
SUPABASE_JWKS_URL=https://xxxxx.supabase.co/auth/v1/.well-known/jwks.json
