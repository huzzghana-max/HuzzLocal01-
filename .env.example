# Huzz Application - Environment Variables Example
# Copy this file to .env and fill in your actual values

## Frontend Configuration
# API base URL - backend server location
# Development: http://localhost:5000/api
# Production: https://huzzgh.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# App metadata
VITE_APP_NAME=Huzz
VITE_APP_VERSION=1.0.0

## Frontend Payment Configuration
# Paystack public key for frontend
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
# Merchant currency for Paystack popup (e.g. GHS or NGN)
VITE_PAYSTACK_CURRENCY=GHS

## Email Configuration (Mailtrap or SMTP)
# SMTP server host
MAIL_HOST=sandbox.smtp.mailtrap.io

# SMTP server port
MAIL_PORT=2525

# Whether to use TLS/SSL
MAIL_SECURE=false

# SMTP username
MAIL_USER=your_mailtrap_username

# SMTP password
MAIL_PASS=your_mailtrap_password

# From email address (format: sender@domain.com)
MAIL_FROM=noreply@huzz.app

## Backend Runtime
# Set to production on hosted backend
NODE_ENV=development

# MySQL connection for the backend API
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=huzz_auth
MYSQL_PORT=3306

# JWT signing secret
JWT_SECRET=change-this-in-real-environments

# Comma-separated origins allowed to call backend APIs (supports wildcard like https://*.vercel.app)
# Example:
# CORS_ORIGIN=http://localhost:5173,https://your-app.vercel.app,https://*.vercel.app
CORS_ORIGIN=http://localhost:5173

# Optional absolute backend URL used for generated file URLs (uploads, etc.)
# Example: PUBLIC_BASE_URL=https://api.yourdomain.com
# PUBLIC_BASE_URL=

## Admin Configuration
# Admin email address for notifications
ADMIN_EMAIL=admin@huzz.app

## Paystack Payment Configuration
# Paystack secret key for backend
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Paystack public key (also used for server-side references)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
# Merchant currency for Paystack backend calls (e.g. GHS or NGN)
PAYSTACK_CURRENCY=GHS

## Optional: Email Service (Resend)
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=noreply@yourdomain.com

## SMS Configuration (Frog or mNotify)
# Frog API key for SMS delivery
FROG_API_KEY=your_frog_api_key_here
# Frog username for SMS API requests
FROG_USERNAME=your_frog_username_here
# Approved Frog sender ID
FROG_SENDER_ID=HUZZ

# mNotify fallback configuration
# MNOTIFY_API_KEY=your_mnotify_api_key_here
# MNOTIFY_SENDER_ID=HUZZ
