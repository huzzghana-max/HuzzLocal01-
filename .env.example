# Huzz Application - Environment Variables Example
# Copy this file to .env and fill in your actual values

## Frontend Configuration
# API base URL - backend server location
VITE_API_BASE_URL=http://localhost:5000/api

# App metadata
VITE_APP_NAME=Huzz
VITE_APP_VERSION=1.0.0

## Frontend Payment Configuration
# Paystack public key for frontend
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

## Email Configuration (Mailtrap or SMTP)
# SMTP server host
MAIL_HOST=sandbox.smtp.mailtrap.io

# SMTP server port
MAIL_PORT=2525

# Whether to use TLS/SSL
MAIL_SECURE=false

# SMTP username
MAIL_USER=your_mailtrap_username

# SMTP password
MAIL_PASS=your_mailtrap_password

# From email address (format: sender@domain.com)
MAIL_FROM=noreply@huzz.app

## Admin Configuration
# Admin email address for notifications
ADMIN_EMAIL=admin@huzz.app

## Paystack Payment Configuration
# Paystack secret key for backend
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here

# Paystack public key (also used for server-side references)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here

## Optional: Email Service (Resend)
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL=noreply@yourdomain.com
